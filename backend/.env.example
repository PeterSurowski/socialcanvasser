# Server
PORT=5000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=socialcanvasser

# JWT
JWT_SECRET=your_jwt_secret_key_change_this_in_production

# Redis (for Bull queue)
REDIS_HOST=localhost
REDIS_PORT=6379

# Encryption key for TikTok session data
ENCRYPTION_KEY=your_32_character_encryption_key_here

# Optional: Route OpenAI API traffic through a debugging proxy (e.g. mitmproxy)
# Example: OPENAI_PROXY_URL=http://127.0.0.1:8080
OPENAI_PROXY_URL=
# Set to false if your MITM cert is not yet trusted by Node
OPENAI_PROXY_REJECT_UNAUTHORIZED=true

# Optional: Global proxy vars for other proxy-aware HTTP clients
HTTP_PROXY=
HTTPS_PROXY=
# Keep local integrations direct (Chrome debug, Incogniton API, DB, Redis)
NO_PROXY=127.0.0.1,localhost
